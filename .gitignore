import random
import string

def generate_password(length=12):
    # Combine letters, digits, and special characters/punctuation
    characters = string.ascii_letters + string.digits + string.punctuation
    
    # Randomly select characters up to the specified length
    password = "".join(random.choice(characters) for _ in range(length))
    return password

if __name__ == "__main__":
    try:
        user_len = int(input("Enter password length (default 12): "))
    except ValueError:
        user_len = 12  # Fallback if input is invalid
        
    print("Generated Password:", generate_password(user_len))
